# Copia este archivo como .env (en Vercel, agrega las mismas variables en Project Settings → Environment Variables)

# --- Supabase (cuentas y sincronización) — ver docs/supabase.md ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- IA (Claude) ---
ANTHROPIC_API_KEY=
# Opcional: modelo a usar
ANTHROPIC_MODEL=claude-opus-5-5
# Correos que pueden usar la IA, separados por coma (requiere Supabase configurado)
AI_ALLOWED_EMAILS=tu.correo@gmail.com
